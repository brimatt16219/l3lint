<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>L3Lint.Cli</RootNamespace>
    <AssemblyName>l3lint</AssemblyName>
    <PackageId>l3lint</PackageId>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>l3lint</ToolCommandName>
    <Description>l3lint command-line tool: lints commercial card Level 2 and Level 3 payloads against Visa, Mastercard, American Express and Discover requirements before submission, and explains each likely downgrade and its fix. Offline; never transmits data.</Description>
  </PropertyGroup>

  <!-- Self-contained single-file ReadyToRun binaries (NFR-004), used with dotnet publish -r RID. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
    <!-- Ship one file: no XML docs or symbol files from referenced projects next to the binary. -->
    <PublishDocumentationFiles>false</PublishDocumentationFiles>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <AllowedReferenceRelatedFileExtensions>.none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\L3Lint.Hosting\L3Lint.Hosting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Templates\**\*" LogicalName="L3Lint.Cli.Templates.%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="L3Lint.Cli.Tests" />
    <InternalsVisibleTo Include="L3Lint.DocsGen" />
  </ItemGroup>

</Project>
