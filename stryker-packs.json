{
  "stryker-config": {
    "test-projects": [
      "../L3Lint.Rules.Tests/L3Lint.Rules.Tests.csproj",
      "../L3Lint.Adapters.Tests/L3Lint.Adapters.Tests.csproj"
    ],
    "test-runner": "mtp",
    "target-framework": "net10.0",
    "mutation-level": "Standard",
    "coverage-analysis": "perTest",
    "concurrency": 4,
    "additional-timeout": 5000,
    "thresholds": {
      "high": 90,
      "low": 80,
      "break": 80
    },
    "mutate": [
      "**/*.cs",
      "!**/obj/**/*.cs"
    ],
    "ignore-methods": [
      "*Log*",
      "ArgumentNullException.ThrowIfNull",
      "ArgumentOutOfRangeException.ThrowIf*"
    ],
    "reporters": [
      "progress",
      "cleartext",
      "html",
      "json"
    ]
  }
}
